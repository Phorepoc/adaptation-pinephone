// wlanhwinit.mmp -- OURS (2026-10-10, PinePhone WiFi W3): the WLAN hardware-init DLL (the same exports as the 2010
// adapt stub oss.FCL.sf.adapt.stubs/wlanhwinit_stub), with the real MAC address: the chip's efuse through the kernel
// (a64_glue.cpp DA64PowerHal function 0x574C). The stub's 00:E0:DE:AD:BE:EF makes wlmserver refuse to start.
TARGET          wlanhwinit.dll
TARGETTYPE      dll
UID             0x1000008d 0x10207267
CAPABILITY      CAP_GENERAL_DLL
VENDORID        0
SOURCEPATH      ../src
SOURCE          wlanhwinit.cpp
OS_LAYER_SYSTEMINCLUDE
LIBRARY         euser.lib
