// pheindprobe.mmp -- OURS (2026-11-18, bug-backlog "New-message indicator clipped"): logs the layout data of the status pane's
// universal indicator pane ("PH: indprobe" lines): the slot rectangle AknIndicatorContainer computes from
// AknLayoutScalable_Avkon::indicator_pane_g1 inside the 80 x 19 pane window. Run it from the ESHELL tty: Z:\sys\bin\pheindprobe.exe
TARGET			pheindprobe.exe
TARGETTYPE		exe
UID				0x1000007a 0xE7016C23
CAPABILITY		All -TCB
VENDORID		0

APP_LAYER_SYSTEMINCLUDE
OS_LAYER_SYSTEMINCLUDE
SOURCEPATH		.
SOURCE			pheindprobe.cpp

LIBRARY			euser.lib cone.lib eikcore.lib avkon.lib CdlEngine.lib AknLayout2.lib AknLayout2Scalable.lib
